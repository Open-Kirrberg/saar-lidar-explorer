{
  "name": "schloss-karlsberg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Researched, georeferenced 3D reconstruction of Schloss Karlsberg (Homburg, 1778-1793) - generator, viewer, plans",
  "scripts": {
    "dev": "vite --port 5260 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5261 --strictPort",
    "test": "vitest run",
    "export": "tsx scripts/export-glb.ts",
    "export:explorer": "tsx scripts/export-explorer.ts",
    "plans": "tsx plans/src/main.ts",
    "textures": "bash scripts/fetch-textures.sh"
  },
  "dependencies": {
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "meshoptimizer": "1.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
