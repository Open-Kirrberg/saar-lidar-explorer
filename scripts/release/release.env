# Release configuration (sourced by export-data.sh / export-code.sh; every value can be overridden
# from the environment, e.g. `XYZ_MAX_ZOOM=16 ./export-data.sh`).
: "${GH_ORG:=Open-Kirrberg}"
: "${PAGES_HOST:=https://open-kirrberg.github.io}"
: "${CODE_REPO:=saar-lidar-explorer}"
: "${DATA_REPO:=saar-lidar-data}"
: "${DATA2_REPO:=saar-lidar-data-2}"
# Staging root (outside the repo): <repo>/../_release
: "${RELEASE_DIR:=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)/_release}"
# AOI shipped publicly ('overall' contains karlsberg/homburg/kirrberg)
: "${RELEASE_AOI:=overall}"
# Leaflet XYZ tiles: highest zoom exported (the app overzooms beyond it)
: "${XYZ_MAX_ZOOM:=17}"
# GitHub Pages limits: published site <= 1 GB, every file < 100 MB (aims: 900 MB / 50 MB)
: "${SITE_HARD_MB:=1000}"
: "${SITE_AIM_MB:=900}"
: "${FILE_HARD_MB:=100}"
: "${FILE_AIM_MB:=50}"
APP_URL="$PAGES_HOST/$CODE_REPO/"
DATA_URL="$PAGES_HOST/$DATA_REPO/"
DATA2_URL="$PAGES_HOST/$DATA2_REPO/"
export GH_ORG PAGES_HOST CODE_REPO DATA_REPO DATA2_REPO RELEASE_DIR RELEASE_AOI XYZ_MAX_ZOOM \
  SITE_HARD_MB SITE_AIM_MB FILE_HARD_MB FILE_AIM_MB APP_URL DATA_URL DATA2_URL
