# Data release configuration (sourced by export-data.sh; every value can be overridden from the environment,
# e.g. `XYZ_MAX_ZOOM=16 ./export-data.sh`). The code is released by `git push origin main` from this
# repository (RELEASING.md §3); CODE_REPO only names the app's Pages path for the data landing pages.
: "${GH_ORG:=Open-Kirrberg}"
: "${PAGES_HOST:=https://open-kirrberg.github.io}"
: "${CODE_REPO:=saar-lidar-explorer}"
: "${DATA_REPO:=saar-lidar-data}"
: "${DATA2_REPO:=saar-lidar-data-2}"
# Data staging root (outside the repo): <repo>/../_release (saar-lidar-data, saar-lidar-data-2 clones;
# set the GitHub noreply identity repo-locally in each, see RELEASING.md "Identity")
: "${RELEASE_DIR:=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)/_release}"
# AOI shipped publicly ('overall' contains karlsberg/homburg/kirrberg)
: "${RELEASE_AOI:=overall}"
# Zone packages published to saar-lidar-data/zones/ (comma list; each must be cleared in
# PUBLIC_ZONE_POLICY of export_data.py). Empty = no zones/ in the public data. The castle ships as
# module zone #1 (ADR 0048); its standalone viewer under /castle/ stays only as a fallback/direct link.
: "${RELEASE_ZONES:=schloss-karlsberg,baeckerei-heusser}"
# Data symlinks are followed only into the repo and these dirs (colon list; missing dirs are ignored). Default:
# the data dir of the sibling `saar-lidar-explorer` checkout, which the v2 checkout links its AOI data from.
: "${RELEASE_LINK_ROOTS:=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)/saar-lidar-explorer/app/public/data}"
# A data export refuses (exit 3, nothing written) to delete more staged files than this per repo
# unless --allow-deletes is given.
: "${RELEASE_MAX_DELETES:=20}"
# Leaflet XYZ tiles: highest zoom exported (the app overzooms beyond it)
: "${XYZ_MAX_ZOOM:=17}"
# GitHub Pages limits: published site <= 1 GB, every file < 100 MB (aims: 900 MB / 50 MB)
: "${SITE_HARD_MB:=1000}"
: "${SITE_AIM_MB:=900}"
: "${FILE_HARD_MB:=100}"
: "${FILE_AIM_MB:=50}"
APP_URL="$PAGES_HOST/$CODE_REPO/"
DATA_URL="$PAGES_HOST/$DATA_REPO/"
DATA2_URL="$PAGES_HOST/$DATA2_REPO/"
export GH_ORG PAGES_HOST CODE_REPO DATA_REPO DATA2_REPO RELEASE_DIR RELEASE_AOI RELEASE_ZONES XYZ_MAX_ZOOM \
  RELEASE_LINK_ROOTS RELEASE_MAX_DELETES \
  SITE_HARD_MB SITE_AIM_MB FILE_HARD_MB FILE_AIM_MB APP_URL DATA_URL DATA2_URL
