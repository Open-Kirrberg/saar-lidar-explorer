{
  "name": "saar-lidar-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/make-fixture.ts --if-missing && vite",
    "dev:lan": "tsx scripts/make-fixture.ts --if-missing && SLE_HTTPS=1 vite --host 0.0.0.0 --port 5243 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve:local": "pnpm run build && vite preview --host 127.0.0.1 --port 5250 --strictPort",
    "test": "vitest run",
    "fixture": "tsx scripts/make-fixture.ts",
    "perf": "node scripts/perf-proxy.mjs",
    "first-run": "node scripts/first-run.mjs",
    "perf:zone": "node scripts/perf-zone.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lil-gui": "0.21.0",
    "proj4": "2.22.0",
    "qrcode-generator": "2.0.4",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.187.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "pngjs": "7.0.0",
    "puppeteer-core": "25.16.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
